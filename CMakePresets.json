{
    "version": 6,
    "configurePresets": [
        {
            "name": "debug",
            "binaryDir": "build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "release",
            "binaryDir": "build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true,
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
            }
        },
        {
            "name": "pgo-generate",
            "inherits": "release",
            "binaryDir": "build/pgo-generate",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-ffast-math -fno-omit-frame-pointer -fprofile-generate -fprofile-update=atomic -funroll-loops -g -march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-ffast-math -fno-exceptions -fno-omit-frame-pointer -fno-rtti -fprofile-generate -fprofile-update=atomic -funroll-loops -g -march=x86-64-v2",
                "CMAKE_EXE_LINKER_FLAGS": "-fprofile-generate"
            }
        },
        {
            "name": "pgo-use",
            "inherits": "release",
            "binaryDir": "build/pgo-use",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_FLAGS": "-ffast-math -fno-omit-frame-pointer -fprofile-use=${sourceDir}/build/pgo-generate/ches/default.profdata -funroll-loops -g -march=x86-64-v2",
                "CMAKE_CXX_FLAGS": "-ffast-math -fno-exceptions -fno-omit-frame-pointer -fno-rtti -fprofile-use=${sourceDir}/build/pgo-generate/ches/default.profdata -funroll-loops -g -march=x86-64-v2",
                "CMAKE_EXE_LINKER_FLAGS": "-fprofile-use=${sourceDir}/build/pgo-generate/ches/default.profdata"
            }
        }
    ]
}